# Copy to .env and fill in. Never commit .env.
LOG_LEVEL=INFO
# Where the app runs: local or production. Tags Logfire traces; logged at start-up.
# Keep local here; FastAPI Cloud sets production (see commands.md).
ENVIRONMENT=local
# Print Logfire spans to the terminal (local trials only: stdout is then no longer pure JSON)
LOGFIRE_CONSOLE=false
# Logfire write token (Logfire project -> Settings -> Write tokens). Empty = nothing is sent.
LOGFIRE_TOKEN=

# OpenAI secret key (platform.openai.com -> API keys; starts with sk-, shown only once).
# Permissions: List models = Read, Responses = Write, everything else None.
# Empty = the app still runs; GET /v1/chat/status answers 503 "not_configured".
OPENAI_API_KEY=
# Model for chat; GET /v1/chat/status checks the key can use it.
OPENAI_MODEL=gpt-6-luna
# Seconds per OpenAI request (504 after), and retries on connection errors, 429 and 5xx.
OPENAI_TIMEOUT_S=30
OPENAI_MAX_RETRIES=2

# Planning London Datahub guest access header (public value from the GLA API doc).
# Used by the pipeline and by the chat tools (live queries).
# Empty = the app still runs; the chat tools answer "not configured".
DATAHUB_ALLOW_REQUEST=be2rmRnt&
# Seconds per Datahub request (504 after); how long an answer is reused for the same
# query (basic caching); most answers kept in that cache.
DATAHUB_TIMEOUT_S=10
DATAHUB_CACHE_TTL_S=600
DATAHUB_CACHE_MAX_ENTRIES=256

# Local PostGIS (compose.yaml): pick any password; it is only used on this machine
POSTGRES_USER=lblchat
POSTGRES_DB=lblchat
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_PASSWORD=change-me

# Hosted database for the bot (e.g. Neon), used only by `pipeline push`.
# Use the direct (non-pooled) connection string, with sslmode=require.
NEON_DATABASE_URL=
