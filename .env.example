# Copy to .env and fill in. Never commit .env.
LOG_LEVEL=INFO
# Print Logfire spans to the terminal (local trials only: stdout is then no longer pure JSON)
LOGFIRE_CONSOLE=false
# Logfire write token (Logfire project -> Settings -> Write tokens). Empty = nothing is sent.
LOGFIRE_TOKEN=

# Planning London Datahub guest access header (public value from the GLA API doc)
DATAHUB_ALLOW_REQUEST=be2rmRnt&

# Local PostGIS (compose.yaml): pick any password; it is only used on this machine
POSTGRES_USER=lblchat
POSTGRES_DB=lblchat
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_PASSWORD=change-me

# Hosted database for the bot (e.g. Neon), used only by `pipeline push`.
# Use the direct (non-pooled) connection string, with sslmode=require.
NEON_DATABASE_URL=
